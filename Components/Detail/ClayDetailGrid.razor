@typeparam TItem

<section class="clay-detail-section @_opt.Class">
    <div class="clay-detail-header">
        <h3 class="clay-detail-title">@Title</h3>
        @if (OnAdd.HasDelegate && !ReadOnly)
        {
            <ClayButton Icon="@Icons.Material.Filled.Add" Text="@_opt.AddTooltip"
                        Disabled="@AddDisabled" OnClick="OnAdd" />
        }
    </div>
    @if (Items.Count == 0)
    {
        <div class="clay-detail-empty">@_opt.EmptyText</div>
    }
    else
    {
        <div class="clay-detail-scroll">
            <table class="mud-table clay-detail-grid">
                <thead>
                    <tr class="mud-table-row">
                        @foreach (var column in Columns)
                        {
                            if (column.IsVisible)
                            {
                                <th class="mud-table-cell">@column.Title</th>
                            }
                        }
                        @if (Actions is not null)
                        {
                            <th class="mud-table-cell clay-detail-actions" aria-label="Действия"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        <tr class="mud-table-row @RowClass?.Invoke(item)">
                            @foreach (var column in Columns)
                            {
                                if (column.IsVisible)
                                {
                                    <td class="mud-table-cell">
                                        @if (column.CellTemplate is not null)
                                        {
                                            @column.CellTemplate(item)
                                        }
                                        else
                                        {
                                            @column.TextSelector(item)
                                        }
                                    </td>
                                }
                            }
                            @if (Actions is not null)
                            {
                                <td class="mud-table-cell clay-detail-actions">@Actions(item)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private ClayDetailGridOptions _opt = new();

    /// <summary>Заголовок секции.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Строки секции.</summary>
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>Описания колонок.</summary>
    [Parameter] public IReadOnlyList<ClayDetailColumn<TItem>> Columns { get; set; } = [];

    /// <summary>Дополнительный CSS-класс строки.</summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>Действия над строкой.</summary>
    [Parameter] public RenderFragment<TItem>? Actions { get; set; }

    /// <summary>Добавление новой строки.</summary>
    [Parameter] public EventCallback OnAdd { get; set; }

    /// <summary>Блокировка добавления.</summary>
    [Parameter] public bool AddDisabled { get; set; }

    /// <summary>Запрет изменений секции.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Настройки оформления секции.</summary>
    [Parameter] public ClayDetailGridOptions? Options { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayDetailGridOptions();
}
