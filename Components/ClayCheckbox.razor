@namespace Clayzor.Lib.Web.Controls.Components

<div class="clay-checkbox @((Disabled || ReadOnly) ? "clay-checkbox--disabled" : "clay-checkbox--clickable") @Class"
     style="@Style"
     title="@Title"
     role="checkbox"
     tabindex="0"
     aria-checked="@AriaChecked"
     aria-disabled="@(Disabled || ReadOnly)"
     @onclick="HandleClick"
     @onclick:stopPropagation="true"
     @onkeydown="HandleKeyDown">
    <span class="clay-checkbox-box @(State == true ? "clay-checkbox-box--checked" : "clay-checkbox-box--unchecked")">
        @if (State is null)
        {
            <span class="clay-checkbox-indeterminate"></span>
        }
        else if (State == true)
        {
            <span class="clay-checkbox-checkmark"></span>
        }
    </span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="clay-checkbox-label"
              title="@(LabelTitle ?? (Label.Length > 30 ? Label : null))">@Label</span>
    }
</div>

@code {
    /// <summary>Состояние: <c>null</c> — «частично», <c>true</c> — отмечен, <c>false</c> — снят.</summary>
    [Parameter] public bool? State { get; set; } = false;

    /// <summary>Событие изменения состояния для двусторонней привязки.</summary>
    [Parameter] public EventCallback<bool?> StateChanged { get; set; }

    /// <summary>Текстовая подпись справа от чекбокса (опционально).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Тултип для подписи (если не задан — авто по длине Label).</summary>
    [Parameter] public string? LabelTitle { get; set; }

    /// <summary>Тултип (HTML-атрибут title).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Блокировка: клик не срабатывает, вид приглушённый.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Запрещает изменение, сохраняя обычную доступность для чтения.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Доп. CSS-класс обёртки.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Доп. inline-стиль обёртки.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Клик по чекбоксу (если не <see cref="Disabled"/>). Родитель сам меняет состояние.</summary>
    [Parameter] public EventCallback OnToggle { get; set; }

    private string AriaChecked => State switch { null => "mixed", true => "true", _ => "false" };

    private async Task HandleClick()
    {
        if (Disabled || ReadOnly) return;
        await StateChanged.InvokeAsync(State == true ? false : true);
        await OnToggle.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == " " || args.Key == "Spacebar")
            await HandleClick();
    }
}
