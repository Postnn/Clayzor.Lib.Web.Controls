@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS

<ClayConfirmedTimeInput @ref="_picker" Time="@Value"
               TimeChanged="@ValueChanged"
               Label="@_opt.Label"
               Placeholder="@(_opt.Required ? " " : null)"
               Required="@_opt.Required"
               RequiredError="@_opt.RequiredError"
               Disabled="@_opt.Disabled"
               ReadOnly="@_opt.ReadOnly"
               TimeFormat="@_opt.TimeFormat"
               AmPm="false"
               Editable="@_opt.Editable"
               Clearable="@_opt.Clearable"
               Variant="@_opt.Variant"
               Margin="@_opt.Margin"
               Class="@FieldClass"
               PickerOpened="@Opened"
               PickerClosed="@ClosedAsync"
               Submitted="@SubmittedAsync"
               data-draft-key="@_opt.DraftKey"
               data-clay-focus-editor="@(_opt.Disabled || _opt.ReadOnly ? null : string.Empty)"
               data-clay-picker-key="@(CanAdvance ? _focus.Key : null)"
               data-clay-picker-kind="time"
               data-clay-enter-native="" />

@code {
    private ClayTimeOptions _opt = new();
    private ClayConfirmedTimeInput _picker = null!;
    private ClayPopupPickerFocus<TimeSpan> _focus = null!;
    private bool CanAdvance => !_opt.Disabled && !_opt.ReadOnly;

    private string FieldClass => _opt.Required && !_opt.Disabled && !_opt.ReadOnly
        ? $"clay-form-field clay-time clay-required-editable {_opt.Class}"
        : $"clay-form-field clay-time {_opt.Class}";

    /// <summary>Текущее время.</summary>
    [Parameter] public TimeSpan? Value { get; set; }

    /// <summary>Событие изменения времени.</summary>
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }

    /// <summary>Настройки формата и оформления.</summary>
    [Parameter] public ClayTimeOptions? Options { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayTimeOptions();

    /// <inheritdoc />
    protected override void OnInitialized() => _focus = new(JS);

    private void Opened() => _focus.Opened();
    private Task SubmittedAsync(TimeSpan? value) => CanAdvance ? _focus.SubmittedAsync(value) : Task.CompletedTask;
    private Task ClosedAsync() => _focus.ClosedAsync(Value, CanAdvance && !_picker.HasErrors);

    /// <inheritdoc />
    public ValueTask DisposeAsync() => _focus.DisposeAsync();
}
