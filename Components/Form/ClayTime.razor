<MudTimePicker Time="@Value"
               TimeChanged="@ValueChanged"
               Label="@_opt.Label"
               Required="@_opt.Required"
               RequiredError="@_opt.RequiredError"
               Disabled="@_opt.Disabled"
               ReadOnly="@_opt.ReadOnly"
               TimeFormat="@_opt.TimeFormat"
               AmPm="false"
               Editable="@_opt.Editable"
               Clearable="@_opt.Clearable"
               Variant="@_opt.Variant"
               Margin="@_opt.Margin"
               Class="@($"clay-time {_opt.Class}")" />

@code {
    private ClayTimeOptions _opt = new();

    /// <summary>Текущее время.</summary>
    [Parameter] public TimeSpan? Value { get; set; }

    /// <summary>Событие изменения времени.</summary>
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }

    /// <summary>Настройки формата и оформления.</summary>
    [Parameter] public ClayTimeOptions? Options { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayTimeOptions();
}
