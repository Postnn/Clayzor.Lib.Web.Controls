<div class="clay-entity-form-layout">
    <MudPaper Class="@($"clay-entity-form {_opt.Class}")"
              MaxWidth="@_opt.MaxWidth"
              Elevation="@_opt.Elevation">
        <div class="clay-entity-form-toolbar">
            @Toolbar
            @EntityFormActions
        </div>
        <div class="clay-entity-form-content">
            @ChildContent
        </div>
    </MudPaper>
    @if (Footer is not null)
    {
        <MudPaper Class="clay-entity-form-footer" MaxWidth="@_opt.MaxWidth" Elevation="0">
            @Footer
        </MudPaper>
    }
</div>

@code {
    private ClayEntityFormOptions _opt = new();

    [CascadingParameter(Name = "EntityFormActions")] private RenderFragment? EntityFormActions { get; set; }

    /// <summary>Команды формы, закреплённые над прокручиваемым содержимым.</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }

    /// <summary>Прокручиваемое содержимое формы.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Содержимое под нижней границей формы.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Настройки ширины и оформления формы.</summary>
    [Parameter] public ClayEntityFormOptions? Options { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayEntityFormOptions();
}
