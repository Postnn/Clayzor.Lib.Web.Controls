@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS

<ClayNumericInput @ref="_field"
                 Value="@Value"
                 ValueChanged="@ValueChanged"
                 Label="@_opt.Label"
                 Placeholder="@(_opt.Required ? " " : null)"
                 Required="@_opt.Required"
                 RequiredError="@_opt.RequiredError"
                 Disabled="@_opt.Disabled"
                 ReadOnly="@_opt.ReadOnly"
                 Min="@_opt.Min"
                 Max="@_opt.Max"
                 Step="@_opt.Step"
                 Format="@NumberFormat"
                 HideSpinButtons="@_opt.HideSpinButtons"
                 Variant="@_opt.Variant"
                 Margin="@_opt.Margin"
                 Class="@FieldClass"
                 data-draft-key="@_opt.DraftKey"
                 OnKeyDown="@CommitEnterAsync"
                 data-clay-text-commit="@(!_opt.Disabled && !_opt.ReadOnly ? _focus.Key : null)" />

@code {
    private ClayNumberOptions _opt = new();
    private ClayNumericInput _field = null!;
    private ClayEditorFocusClient _focus = null!;
    private bool _committing;

    private string FieldClass => _opt.Required && !_opt.Disabled && !_opt.ReadOnly
        ? $"clay-form-field clay-required-editable {_opt.Class}"
        : $"clay-form-field {_opt.Class}";

    /// <summary>Текущее числовое значение.</summary>
    [Parameter] public decimal? Value { get; set; }

    /// <summary>Событие изменения значения.</summary>
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }

    /// <summary>Настройки диапазона, точности и оформления.</summary>
    [Parameter] public ClayNumberOptions? Options { get; set; }

    private string NumberFormat => _opt.Precision <= 0 ? "0" : "0." + new string('0', Math.Min(_opt.Precision, 10));

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayNumberOptions();

    /// <inheritdoc />
    protected override void OnInitialized() => _focus = new(JS);

    private async Task CommitEnterAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key != "Enter" || _opt.Disabled || _opt.ReadOnly || _committing) return;
        var field = _field;
        var options = _opt;
        var original = Value;
        _committing = true;
        try
        {
            var entry = await _focus.ClaimTextEntryAsync();
            if (entry is null || !IsCurrent() || Value != original) return;
            var result = await field.CommitEnterValueAsync(entry.Value);
            if (result.Accepted && Value == result.Value && IsCurrent())
                await _focus.CompleteTextEntryAsync(entry.Id);
        }
        finally { _committing = false; }

        bool IsCurrent() => ReferenceEquals(field, _field) && ReferenceEquals(options, _opt) &&
            !_opt.Disabled && !_opt.ReadOnly;
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync() => _focus.DisposeAsync();
}
