@inject IJSRuntime JS

<div class="clay-changed @_opt.Class">
    @if (ChangedById is > 0 && ChangedAt is not null)
    {
        <span class="clay-changed-label">@_opt.Label</span>
        @if (!string.IsNullOrWhiteSpace(ChangedByUrl))
        {
            <a class="clay-changed-user" href="@ChangedByUrl" target="_blank" rel="noopener noreferrer">@DisplayName</a>
        }
        else
        {
            <span class="clay-changed-user">@DisplayName</span>
        }
        <time class="clay-changed-date" datetime="@UtcChangedAt.ToString("O")">@DisplayChangedAt</time>
    }
</div>

@code {
    private ClayChangedOptions _opt = new();
    private DateTime? _localChangedAt;
    private DateTime? _convertedUtc;

    /// <summary>Идентификатор сотрудника, изменившего запись.</summary>
    [Parameter] public int? ChangedById { get; set; }

    /// <summary>Отображаемое имя сотрудника.</summary>
    [Parameter] public string? ChangedByName { get; set; }

    /// <summary>Дата и время последнего изменения в UTC.</summary>
    [Parameter] public DateTime? ChangedAt { get; set; }

    /// <summary>URL карточки сотрудника.</summary>
    [Parameter] public string? ChangedByUrl { get; set; }

    /// <summary>Настройки подписи и формата даты.</summary>
    [Parameter] public ClayChangedOptions? Options { get; set; }

    private string DisplayName => !string.IsNullOrWhiteSpace(ChangedByName) ? ChangedByName : $"#{ChangedById}";
    private DateTime UtcChangedAt => DateTime.SpecifyKind(ChangedAt!.Value, DateTimeKind.Utc);
    private string DisplayChangedAt => _convertedUtc == ChangedAt && _localChangedAt is not null
        ? _localChangedAt.Value.ToString(_opt.DateTimeFormat)
        : string.Empty;

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayChangedOptions();

    /// <summary>Переводит UTC-время записи в часовой пояс браузера после интерактивного рендера.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ChangedAt is null || _convertedUtc == ChangedAt)
            return;
        var utc = UtcChangedAt;
        try
        {
            var offsetMinutes = await JS.InvokeAsync<int>(
                "clayGridTimeZone.getOffsetMinutes", utc.ToString("O"));
            if (ChangedAt != utc)
                return;
            _localChangedAt = utc.AddMinutes(offsetMinutes);
            _convertedUtc = ChangedAt;
            StateHasChanged();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
