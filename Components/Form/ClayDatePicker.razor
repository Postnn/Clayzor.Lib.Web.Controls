@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS

<ClayConfirmedDateInput @ref="_picker" Date="@Value"
               DateChanged="@ValueChanged"
               Label="@_opt.Label"
               Placeholder="@(_opt.Required ? " " : null)"
               Required="@_opt.Required"
               RequiredError="@_opt.RequiredError"
               Disabled="@_opt.Disabled"
               ReadOnly="@_opt.ReadOnly"
               MinDate="@_opt.MinDate"
               MaxDate="@_opt.MaxDate"
               DateFormat="@_opt.DateFormat"
               Editable="@_opt.Editable"
               Clearable="@_opt.Clearable"
               Variant="@_opt.Variant"
               Margin="@_opt.Margin"
               Class="@FieldClass"
               PickerOpened="@Opened"
               PickerClosed="@ClosedAsync"
               Submitted="@SubmittedAsync"
               data-draft-key="@_opt.DraftKey"
               data-clay-focus-editor="@(_opt.Disabled || _opt.ReadOnly ? null : string.Empty)"
               data-clay-picker-key="@(CanAdvance ? _focus.Key : null)"
               data-clay-picker-kind="date"
               data-clay-enter-native="" />

@code {
    private ClayDatePickerOptions _opt = new();
    private ClayConfirmedDateInput _picker = null!;
    private ClayPopupPickerFocus<DateTime> _focus = null!;
    private bool CanAdvance => !_opt.Disabled && !_opt.ReadOnly;

    private string FieldClass => _opt.Required && !_opt.Disabled && !_opt.ReadOnly
        ? $"clay-form-field clay-date clay-required-editable {_opt.Class}"
        : $"clay-form-field clay-date {_opt.Class}";

    /// <summary>Текущая дата.</summary>
    [Parameter] public DateTime? Value { get; set; }

    /// <summary>Событие изменения даты.</summary>
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }

    /// <summary>Настройки диапазона, формата и оформления.</summary>
    [Parameter] public ClayDatePickerOptions? Options { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => _opt = Options ?? new ClayDatePickerOptions();

    /// <inheritdoc />
    protected override void OnInitialized() => _focus = new(JS);

    private void Opened() => _focus.Opened();
    private Task SubmittedAsync(DateTime? value) => CanAdvance ? _focus.SubmittedAsync(value) : Task.CompletedTask;
    private Task ClosedAsync() => _focus.ClosedAsync(Value, CanAdvance && !_picker.HasErrors);

    /// <inheritdoc />
    public ValueTask DisposeAsync() => _focus.DisposeAsync();
}
