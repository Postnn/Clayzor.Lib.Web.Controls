@namespace Clayzor.Lib.Web.Controls.Components.Form
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="clay-field-change" data-clay-field-changed="@(Changed ? "" : null)"
     data-clay-field-watch-raw="@(WatchesRaw ? "" : null)"
     role="@(Changed ? "group" : null)" aria-describedby="@(Changed ? _descriptionId : null)">
    <CascadingValue Name="ClayWatchLookupRaw" Value="@WatchLookupRaw">
        @ChildContent
    </CascadingValue>
    @if (Changed)
    {
        <span id="@_descriptionId" class="clay-field-change-description">Есть несохранённое изменение</span>
    }
    @if (WatchesRaw)
    {
        <span id="@_rawDescriptionId" class="clay-field-change-description" data-clay-field-raw-description aria-live="polite"></span>
    }
</div>

@code {
    private readonly string _descriptionId = $"clay-field-change-{Guid.NewGuid():N}";
    private readonly string _rawDescriptionId = $"clay-field-raw-{Guid.NewGuid():N}";
    private ElementReference _root;
    private Task<IJSObjectReference>? _module;
    private (string? Baseline, bool Lookup, bool Changed)? _applied;
    private bool _disposed;
    private bool WatchesRaw => RawBaseline is not null || WatchLookupRaw;

    /// <summary>Поле отличается от принятого исходного значения редактора.</summary>
    [Parameter] public bool Changed { get; set; }

    /// <summary>Принятый исходный текст обычного поля. Пустая строка включает сравнение с пустым полем.</summary>
    [Parameter] public string? RawBaseline { get; set; }

    /// <summary>Учитывает введённое имя справочника до подтверждения выбранного идентификатора.</summary>
    [Parameter] public bool WatchLookupRaw { get; set; }

    /// <summary>Содержимое одного логического поля.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || (!WatchesRaw && _module is null)) return;
        try
        {
            _module ??= JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/Clayzor.Lib.Web.Controls/js/clayFieldChange.js").AsTask();
            var module = await _module;
            var state = (RawBaseline, WatchLookupRaw, Changed);
            if (_disposed || _applied == state) return;
            await module.InvokeVoidAsync("update", _root, state.RawBaseline, state.WatchLookupRaw);
            _applied = state;
        }
        catch (Exception error) when (IsInteropFailure(error))
        {
            _module = null;
            _applied = null;
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not { } pending) return;
        try
        {
            var module = await pending;
            try { await module.InvokeVoidAsync("detach", _root); }
            finally { await module.DisposeAsync(); }
        }
        catch (Exception error) when (IsInteropFailure(error)) { }
    }

    private static bool IsInteropFailure(Exception error) =>
        error is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException;
}
