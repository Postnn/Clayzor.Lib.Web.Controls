@namespace Clayzor.Lib.Web.Controls.Components.Tree
@using Clayzor.Lib.Web.Controls.Components.Tree.Models
@using MudBlazor

<CascadingValue Value="(IClayTreeView)this" IsFixed="true">
    <div class="clay-tree @Options.Class" style="@Options.Style">
        @* ── Панель фильтра ────────────────────────────────────────────── *@
        @if (BuildFilterColumns().Count > 0)
        {
            <div class="clay-tree-toolbar">
                <div class="clay-tree-toolbar-row">
                    <MudBadge Content="@ActiveFilterCount"
                              Visible="@(ActiveFilterCount > 0)"
                              Color="Color.Primary"
                              Overlap="true">
                        <ClayButton Text="@(FilterTooltip ?? "Фильтр")"
                                    Icon="@Icons.Material.Filled.FilterList"
                                    OnClick="@OpenTreeFilterDialogAsync" />
                    </MudBadge>
                    @if (IsFilterActive)
                    {
                        <ClayButton Text="Удалить фильтр"
                                    Icon="@Icons.Material.Filled.Close"
                                    OnClick="@ClearTreeFilterAsync" />
                    }
                </div>
                @if (IsFilterActive)
                {
                    <div class="clay-tree-toolbar-info">
                        @if (_filterCapped)
                        {
                            <span>Найдено более @Options.MaxFilterRecords записей. Отображаются только @Options.MaxFilterRecords, уточните критерии поиска.</span>
                        }
                        else
                        {
                            <span>Найдено записей: @_filterMatchCount</span>
                        }
                    </div>
                }
            </div>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="clay-tree-error mb-2" Variant="Variant.Outlined">
                @_error
            </MudAlert>
        }
        else if (_roots.Count == 0 && !_isBusy)
        {
            <div class="clay-tree-empty">Нет данных</div>
        }
        else
        {
            @foreach (var node in _roots)
            {
                <ClayTreeNodeView Node="node" Tree="this" NodeTemplate="NodeTemplate" />
            }
        }

        <MudOverlay Visible="@_isBusy" DarkBackground="true">
            <div class="clay-busy">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <span>@_busyLabel</span>
            </div>
        </MudOverlay>
    </div>
</CascadingValue>
