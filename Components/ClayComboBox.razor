@typeparam TItem where TItem : ILookupEntity
@using Clayzor.Lib.Web.Controls.Components.Form
@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS

<MudSelect T="int"
           Value="@Value"
           ValueChanged="@AcceptValueAsync"
           OpenChanged="@OnOpenChangedAsync"
           ToStringFunc="@ToStringFunc"
           Label="@Label"
           Variant="@Variant"
           Required="@Required"
           RequiredError="@RequiredError"
           Class="@(Required && string.IsNullOrEmpty(ToStringFunc(Value)) ? $"clay-form-field clay-required-empty {Class}" : $"clay-form-field {Class}")"
           Margin="Margin.Dense"
           Dense="true"
           PopoverClass="clay-combo-popover"
           data-clay-focus-editor=""
           data-clay-fixed-picker="@(AdvanceFocusOnSelection ? _focus.Key : null)">
    @if (_items is not null)
    {
        @foreach (var item in _items)
        {
            <MudSelectItem T="int" Value="@item.Id">@item.Name</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<TItem> _items = [];
    private ClayEditorFocusClient _focus = null!;

    /// <summary>Выбранное значение (Id справочной сущности).</summary>
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    /// <summary>Элементы справочника.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    /// <summary>Надпись поля.</summary>
    [Parameter] public string Label { get; set; } = string.Empty;
    /// <summary>Вариант отображения.</summary>
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    /// <summary>Обязательность.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Текст ошибки обязательного поля.</summary>
    [Parameter] public string? RequiredError { get; set; }
    /// <summary>CSS-классы.</summary>
    [Parameter] public string? Class { get; set; }
    /// <summary>После подтверждения выбора переводит фокус внутри активной области формы.</summary>
    [Parameter] public bool AdvanceFocusOnSelection { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() => _focus = new(JS);

    protected override void OnParametersSet()
    {
        _items = Items?.ToList() ?? [];
    }

    private string ToStringFunc(int v)
    {
        return _items.FirstOrDefault(i => i.Id == v)?.Name ?? string.Empty;
    }

    private async Task AcceptValueAsync(int value)
    {
        var lease = AdvanceFocusOnSelection ? await _focus.ClaimAsync() : null;
        await ValueChanged.InvokeAsync(value);
        if (AdvanceFocusOnSelection && Value == value)
            await _focus.CompleteAsync(lease);
    }

    private async Task OnOpenChangedAsync(bool open)
    {
        if (open || !AdvanceFocusOnSelection) return;
        var selected = Value;
        var lease = await _focus.ClaimAsync(alreadySelected: true);
        if (AdvanceFocusOnSelection && Value == selected)
            await _focus.CompleteAsync(lease);
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync() => _focus.DisposeAsync();
}
